          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (trigger) (increase(gdmarket_quotes_recalculation_seconds_sum[7d])) / sum by (trigger) (increase(gdmarket_quotes_recalculation_seconds_count[7d]))",
          "legendFormat": "{{trigger}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "timeFrom": "7d"
    },
