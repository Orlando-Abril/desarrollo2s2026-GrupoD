      "description": "Última duración registrada en los 7 días anteriores; sobrevive a reinicios del backend.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
